default_platform(:ios)

APP_ID = "it.pgssalgen.pgs"
APP_NAME = "PGS Salgen"

platform :ios do
  # Autenticazione tramite App Store Connect API key (nessuna password/2FA).
  def asc_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"), # contenuto .p8 in base64
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "Build e upload su TestFlight (cloud signing via API key)"
  lane :beta do
    api = asc_key

    # Registra App ID + app su App Store Connect (idempotente)
    begin
      produce(
        app_identifier: APP_ID,
        app_name: APP_NAME,
        language: "Italian",
        team_id: ENV.fetch("APPLE_TEAM_ID")
      )
    rescue => e
      UI.message("produce: #{e.message} (l'app probabilmente esiste già)")
    end

    # Archivio + IPA con firma gestita da Apple (crea cert/profilo in cloud).
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "PGS.ipa",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}"
      ].join(" "),
      export_options: {
        signingStyle: "automatic",
        teamID: ENV.fetch("APPLE_TEAM_ID")
      }
    )

    upload_to_testflight(
      api_key: api,
      skip_waiting_for_build_processing: true
    )
  end
end
